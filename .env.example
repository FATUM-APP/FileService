# =============================================================================================
# FileService — variables de entorno
# =============================================================================================

# --- Servicio ---
PORT=8081
# Secreto esperado en la cabecera X-Storage-Key. Vacío desactiva la comprobación (solo local).
STORAGE_INTERNAL_SECRET=cambia-este-secreto
STORAGE_PRESIGN_TTL=15m

# --- AWS ---
AWS_REGION=us-east-1

# --- Buckets por ruta ---
S3_USER_PROFILE_IMAGES_BUCKET=fatum-user-profile-902353451847-us-east-1-an
# S3_USER_LIVENESS_BUCKET=          # por defecto usa el de perfil
S3_USER_DOCUMENTS_BUCKET=fatum-documents-902353451847-us-east-1-an
S3_RATINGS_PHOTOS_BUCKET=fatum-ratings-902353451847-us-east-1-an
S3_CATALOG_PHOTOS_BUCKET=fatum-catalog-902353451847-us-east-1-an

# === Opcionales (tienen valor por defecto) ===
# STORAGE_DEFAULT_ROUTE=
# STORAGE_MAX_FILE_SIZE=15MB
# STORAGE_MAX_REQUEST_SIZE=15MB
# S3_USER_PROFILE_IMAGES_MAX_SIZE=5MB
# S3_USER_LIVENESS_MAX_SIZE=5MB
# S3_USER_DOCUMENTS_MAX_SIZE=10MB
